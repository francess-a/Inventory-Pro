// Prisma schema for the hotel centralized warehouse inventory management system.
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum ItemCategory {
  GROCERY
  VEGETABLE
  DAIRY
  PORK
  CHICKEN
  BEEF
  BIRDS
  MUTTON
  SEAFOOD
  LINEN
  AMENITIES
  SPARES
  FRONT_OFFICE
  BAR
}

enum AbcCategory {
  A
  B
  C
}

enum XyzCategory {
  X
  Y
  Z
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  RECEIVED
  PARTIALLY_RECEIVED
  CANCELLED
}

enum MainOutlet {
  FB
  HOUSEKEEPING
  FRONT_OFFICE
  BAR
  MAINTENANCE
  MAIN_KITCHEN
}

enum SubDepartment {
  TANDOOR
  CONTINENTAL
  BAKERY
  CHINESE
  SOUTH_INDIAN
  NORTH_INDIAN
  IDLY_DOSA
  STAFF_FOOD
  NONE
}

enum RequisitionStatus {
  PENDING
  APPROVED
  ISSUED
  REJECTED
}

enum TransactionType {
  PURCHASE_RECEIPT
  OUTLET_ISSUE
  ADJUSTMENT
  WASTE
}

enum PriceSource {
  PURCHASE_RECEIPT // actual landed price from a goods receipt
  VENDOR_QUOTE // quotation received from a supplier
  MARKET_FEED // wholesale / mandi / market rate (manual entry or external feed)
}

// ─────────────────────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────────────────────

model Item {
  id            String       @id @default(uuid()) @db.Uuid
  sku           String       @unique
  barcode       String       @unique
  itemName      String
  category      ItemCategory
  costPrice     Decimal      @db.Decimal(12, 2) // weighted average cost, updated on every receipt
  unitOfMeasure String // e.g. kg, ltr, pcs, pack
  minStockLevel Int // safety stock
  maxStockLevel Int
  reorderPoint  Int

  // Classifications are computed by the application (consumption value / demand
  // variability analysis), so they stay null until the first analysis run.
  abcCategory AbcCategory?
  xyzCategory XyzCategory?

  // When true, the replenishment engine overwrites min/max/reorder point from
  // consumption history. Set to false to keep manually maintained levels.
  autoPlanning      Boolean @default(true)
  orderMultiple     Int     @default(1) // suggested order quantities are rounded up to this pack size
  preferredVendorId String? @db.Uuid
  isActive          Boolean @default(true)

  centralStock     CentralStock?
  outletStocks     OutletStock[]
  transactionLogs  InventoryTransaction[]
  orderItems       PurchaseOrderItem[]
  requisitionItems RequisitionItem[]
  priceQuotes      PriceQuote[]
  preferredVendor  Vendor?                @relation("PreferredVendor", fields: [preferredVendorId], references: [id], onDelete: SetNull)

  @@index([category])
}

model Vendor {
  id           String  @id @default(uuid()) @db.Uuid
  vendorName   String
  contactName  String
  email        String
  phone        String
  leadTimeDays Int // Expected time between PO placement and dock delivery
  isActive     Boolean @default(true)

  purchaseOrders PurchaseOrder[]
  priceQuotes    PriceQuote[]
  preferredItems Item[]          @relation("PreferredVendor")
}

model PurchaseOrder {
  id                 String              @id @default(uuid()) @db.Uuid
  poNumber           String              @unique
  vendorId           String              @db.Uuid
  status             PurchaseOrderStatus @default(DRAFT)
  createdAt          DateTime            @default(now())
  sentAt             DateTime?
  expectedDeliveryAt DateTime? // sentAt + vendor lead time unless overridden
  receivedAt         DateTime? // first dock delivery; drives actual lead time
  invoiceNumber      String?
  notes              String?

  items  PurchaseOrderItem[]
  vendor Vendor              @relation(fields: [vendorId], references: [id])

  @@index([vendorId])
  @@index([status])
}

model PurchaseOrderItem {
  id               String  @id @default(uuid()) @db.Uuid
  poId             String  @db.Uuid
  itemId           String  @db.Uuid
  quantityOrdered  Int
  quantityReceived Int     @default(0)
  quantityRejected Int     @default(0)
  rejectionReason  String?
  unitPrice        Decimal @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  item          Item          @relation(fields: [itemId], references: [id])

  @@index([poId])
  @@index([itemId])
}

model OutletDepartment {
  id            String        @id @default(uuid()) @db.Uuid
  mainOutlet    MainOutlet
  subDepartment SubDepartment @default(NONE)

  outletStocks OutletStock[]
  requisitions Requisition[]

  @@unique([mainOutlet, subDepartment])
}

model CentralStock {
  id             String  @id @default(uuid()) @db.Uuid
  itemId         String  @unique @db.Uuid
  quantityOnHand Int     @default(0)
  totalValue     Decimal @default(0) @db.Decimal(14, 2) // quantityOnHand * costPrice

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model OutletStock {
  id                 String @id @default(uuid()) @db.Uuid
  outletDepartmentId String @db.Uuid
  itemId             String @db.Uuid
  quantityOnHand     Int    @default(0)

  item       Item             @relation(fields: [itemId], references: [id], onDelete: Cascade)
  department OutletDepartment @relation(fields: [outletDepartmentId], references: [id], onDelete: Cascade)

  @@unique([outletDepartmentId, itemId])
  @@index([itemId])
}

model Requisition {
  id                 String            @id @default(uuid()) @db.Uuid
  requisitionNumber  String            @unique
  outletDepartmentId String            @db.Uuid
  status             RequisitionStatus @default(PENDING)
  requestedBy        String
  createdAt          DateTime          @default(now())
  approvedBy         String?
  approvedAt         DateTime?
  issuedBy           String?
  issuedAt           DateTime?
  remarks            String?

  items      RequisitionItem[]
  department OutletDepartment  @relation(fields: [outletDepartmentId], references: [id])

  @@index([outletDepartmentId])
  @@index([status])
}

model RequisitionItem {
  id                String   @id @default(uuid()) @db.Uuid
  requisitionId     String   @db.Uuid
  itemId            String   @db.Uuid
  quantityRequested Int
  quantityIssued    Int      @default(0)
  unitCost          Decimal? @db.Decimal(12, 2) // weighted average cost at the moment of issue
  issuedValue       Decimal  @default(0) @db.Decimal(14, 2)

  requisition Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  item        Item        @relation(fields: [itemId], references: [id])

  @@index([requisitionId])
  @@index([itemId])
}

model InventoryTransaction {
  id                       String          @id @default(uuid()) @db.Uuid
  itemId                   String          @db.Uuid
  type                     TransactionType
  sourceLocation           String // 'CENTRAL', 'VENDOR:<uuid>' or OutletDepartment UUID
  destinationLocation      String // 'CENTRAL', OutletDepartment UUID or 'WASTE_BIN'
  quantity                 Int
  unitCost                 Decimal         @db.Decimal(12, 2)
  transactionValue         Decimal         @db.Decimal(14, 2)
  closingStockCentral      Int
  closingStockCentralValue Decimal         @db.Decimal(14, 2)
  referenceId              String? // PurchaseOrder / Requisition id that caused the movement
  remarks                  String?
  timestamp                DateTime        @default(now())

  item Item @relation(fields: [itemId], references: [id])

  @@index([itemId, timestamp])
  @@index([type, timestamp])
}

model PriceQuote {
  id         String      @id @default(uuid()) @db.Uuid
  itemId     String      @db.Uuid
  vendorId   String?     @db.Uuid // null for market rates not tied to a supplier
  source     PriceSource
  unitPrice  Decimal     @db.Decimal(12, 2)
  market     String? // e.g. 'Koyambedu wholesale', 'Metro Cash & Carry'
  recordedAt DateTime    @default(now())

  item   Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  vendor Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([itemId, recordedAt])
  @@index([vendorId])
}
