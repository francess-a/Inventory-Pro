// Prisma schema for the hotel centralized warehouse inventory management system.
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum ItemCategory {
  GROCERY
  VEGETABLE
  DAIRY
  PORK
  CHICKEN
  BEEF
  BIRDS
  MUTTON
  SEAFOOD
  LINEN
  AMENITIES
  SPARES
  FRONT_OFFICE
  BAR
}

enum AbcCategory {
  A
  B
  C
}

enum XyzCategory {
  X
  Y
  Z
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  RECEIVED
  PARTIALLY_RECEIVED
  CANCELLED
}

enum MainOutlet {
  FB
  HOUSEKEEPING
  FRONT_OFFICE
  BAR
  MAINTENANCE
  MAIN_KITCHEN
}

enum SubDepartment {
  TANDOOR
  CONTINENTAL
  BAKERY
  CHINESE
  SOUTH_INDIAN
  NORTH_INDIAN
  IDLY_DOSA
  STAFF_FOOD
  NONE
}

enum RequisitionStatus {
  PENDING
  APPROVED
  ISSUED
  REJECTED
}

enum TransactionType {
  PURCHASE_RECEIPT
  OUTLET_ISSUE
  ADJUSTMENT
  WASTE
}

// ─────────────────────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────────────────────

model Item {
  id            String       @id @default(uuid()) @db.Uuid
  sku           String       @unique
  barcode       String       @unique
  itemName      String
  category      ItemCategory
  costPrice     Decimal      @db.Decimal(12, 2)
  unitOfMeasure String // e.g. kg, ltr, pcs, pack
  minStockLevel Int
  maxStockLevel Int
  reorderPoint  Int

  // Classifications are computed by the application (consumption value / demand
  // variability analysis), so they stay null until the first analysis run.
  abcCategory AbcCategory?
  xyzCategory XyzCategory?

  centralStock     CentralStock?
  outletStocks     OutletStock[]
  transactionLogs  InventoryTransaction[]
  orderItems       PurchaseOrderItem[]
  requisitionItems RequisitionItem[]

  @@index([category])
}

model Vendor {
  id           String @id @default(uuid()) @db.Uuid
  vendorName   String
  contactName  String
  email        String
  phone        String
  leadTimeDays Int // Expected time between PO placement and dock delivery

  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id         String              @id @default(uuid()) @db.Uuid
  poNumber   String              @unique
  vendorId   String              @db.Uuid
  status     PurchaseOrderStatus @default(DRAFT)
  createdAt  DateTime            @default(now())
  receivedAt DateTime?

  items  PurchaseOrderItem[]
  vendor Vendor              @relation(fields: [vendorId], references: [id])

  @@index([vendorId])
  @@index([status])
}

model PurchaseOrderItem {
  id               String  @id @default(uuid()) @db.Uuid
  poId             String  @db.Uuid
  itemId           String  @db.Uuid
  quantityOrdered  Int
  quantityReceived Int     @default(0)
  quantityRejected Int     @default(0)
  rejectionReason  String?

  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  item          Item          @relation(fields: [itemId], references: [id])

  @@index([poId])
  @@index([itemId])
}

model OutletDepartment {
  id            String        @id @default(uuid()) @db.Uuid
  mainOutlet    MainOutlet
  subDepartment SubDepartment @default(NONE)

  outletStocks OutletStock[]
  requisitions Requisition[]

  @@unique([mainOutlet, subDepartment])
}

model CentralStock {
  id             String  @id @default(uuid()) @db.Uuid
  itemId         String  @unique @db.Uuid
  quantityOnHand Int     @default(0)
  totalValue     Decimal @default(0) @db.Decimal(14, 2) // quantityOnHand * costPrice

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model OutletStock {
  id                 String @id @default(uuid()) @db.Uuid
  outletDepartmentId String @db.Uuid
  itemId             String @db.Uuid
  quantityOnHand     Int    @default(0)

  item       Item             @relation(fields: [itemId], references: [id], onDelete: Cascade)
  department OutletDepartment @relation(fields: [outletDepartmentId], references: [id], onDelete: Cascade)

  @@unique([outletDepartmentId, itemId])
  @@index([itemId])
}

model Requisition {
  id                 String            @id @default(uuid()) @db.Uuid
  outletDepartmentId String            @db.Uuid
  status             RequisitionStatus @default(PENDING)
  requestedBy        String
  createdAt          DateTime          @default(now())

  items      RequisitionItem[]
  department OutletDepartment  @relation(fields: [outletDepartmentId], references: [id])

  @@index([outletDepartmentId])
  @@index([status])
}

model RequisitionItem {
  id                String @id @default(uuid()) @db.Uuid
  requisitionId     String @db.Uuid
  itemId            String @db.Uuid
  quantityRequested Int
  quantityIssued    Int    @default(0)

  requisition Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  item        Item        @relation(fields: [itemId], references: [id])

  @@index([requisitionId])
  @@index([itemId])
}

model InventoryTransaction {
  id                       String          @id @default(uuid()) @db.Uuid
  itemId                   String          @db.Uuid
  type                     TransactionType
  sourceLocation           String // 'CENTRAL' or OutletDepartment UUID
  destinationLocation      String // OutletDepartment UUID or 'WASTE_BIN'
  quantity                 Int
  closingStockCentral      Int
  closingStockCentralValue Decimal         @db.Decimal(14, 2)
  timestamp                DateTime        @default(now())

  item Item @relation(fields: [itemId], references: [id])

  @@index([itemId, timestamp])
  @@index([type])
}
