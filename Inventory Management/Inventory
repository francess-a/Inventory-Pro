#!/bin/bash

# Create workflows folder
mkdir -p .github/workflows

# 1. Deploy Workflow
cat > .github/workflows/deploy.yml << 'EOF'
name: Deploy Inventory System
on:
  push:
    branches: [main]
jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Build Docker image
        run: docker build -t inventory-system:latest .
      - name: Push to Azure Registry
        run: |
          docker login ${{ secrets.AZURE_REGISTRY_LOGIN_SERVER }} \
            -u ${{ secrets.AZURE_REGISTRY_USERNAME }} \
            -p ${{ secrets.AZURE_REGISTRY_PASSWORD }}
          docker tag inventory-system:latest ${{ secrets.AZURE_REGISTRY_LOGIN_SERVER }}/inventory-system:latest
          docker push ${{ secrets.AZURE_REGISTRY_LOGIN_SERVER }}/inventory-system:latest
      - name: Deploy to Azure Web App
        run: |
          az webapp create \
            --resource-group ${{ secrets.AZURE_RESOURCE_GROUP }} \
            --plan ${{ secrets.AZURE_APP_PLAN }} \
            --name ${{ secrets.AZURE_WEBAPP_NAME }} \
            --deployment-container-image-name ${{ secrets.AZURE_REGISTRY_LOGIN_SERVER }}/inventory-system:latest
EOF

# 2. Backup Workflow
cat > .github/workflows/backup.yml << 'EOF'
name: Nightly Backup
on:
  schedule:
    - cron: "0 0 * * *"
jobs:
  backup:
    runs-on: ubuntu-latest
    steps:
      - name: Dump MongoDB
        run: mongodump --uri="${{ secrets.MONGO_URI }}" --archive=backup.gz
      - name: Upload Backup
        uses: actions/upload-artifact@v4
        with:
          name: nightly-backup
          path: backup.gz
EOF

# 3. Restore Workflow
cat > .github/workflows/restore.yml << 'EOF'
name: Manual Restore
on:
  workflow_dispatch:
jobs:
  restore:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/download-artifact@v4
        with:
          name: nightly-backup
      - name: Restore MongoDB
        run: mongorestore --uri="${{ secrets.MONGO_URI }}" --archive=backup.gz --drop
EOF

# 4. Health Check
cat > .github/workflows/health-check.yml << 'EOF'
name: Daily Health Check
on:
  schedule:
    - cron: "0 6 * * *"
jobs:
  healthcheck:
    runs-on: ubuntu-latest
    steps:
      - run: |
          STATUS=$(curl -s -o /dev/null -w "%{http_code}" https://your-app-url.com/health)
          if [ "$STATUS" -ne 200 ]; then exit 1; fi
EOF

